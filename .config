# --- Imagen durante el arranque, antes de que cargue el driver de la GPU ---
#
# Sin esto, en un equipo UEFI real no hay NADA que pueda dibujar en la pantalla
# hasta que amdgpu (o el driver que toque) esté cargado con su firmware. Si algo
# falla antes de ese momento, la pantalla se queda como la dejó GRUB y no vuelve
# a cambiar: parece que el equipo se ha colgado cuando en realidad está
# arrancando, sólo que a ciegas. Pasó en una Surface Laptop 4.
#
# No salió en las pruebas porque en QEMU la salida se leía por el puerto serie,
# no de la pantalla. Una máquina virtual no tiene este problema; un portátil sí.
#
#   SYSFB_SIMPLEFB   registra el framebuffer que deja la UEFI como un
#                    dispositivo "simple-framebuffer"
#   DRM_SIMPLEDRM    es quien se engancha a ese dispositivo y pinta
#   FB_EFI           el camino antiguo, por si el anterior no encaja
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_QXL=y
CONFIG_DRM_VMWGFX=y
CONFIG_VMWARE_PVSCSI=y
CONFIG_VMXNET3=y
CONFIG_HYPERV=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_BALLOON=y
CONFIG_VBOXGUEST=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_INPUT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_DEFAULT_HOSTNAME="mikeos"

# Audio. El controlador HDA ya venía en defconfig, pero sin ningún driver de
# códec: el kernel encontraba la tarjeta y moría en "Cannot probe codecs,
# giving up", así que el sistema arrancaba sin ninguna salida de sonido.
# El códec genérico es el que expone QEMU (QEMU HDA); los demás cubren el
# hardware real más común, y USB_AUDIO los cascos y tarjetas externas.
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_USB_AUDIO=y

# =============================================================================
# HARDWARE REAL — Surface Laptop 4 / 3 con AMD (Ryzen + gráficos Vega)
#
# Hasta aquí, el kernel se construía con "make defconfig" más cuatro cosas de
# máquina virtual. Eso arranca en QEMU y en nada más: no había NVMe (o sea que
# la Surface no vería ni su propio disco), ni gráficos, ni WiFi, ni teclado.
#
# Todo va compilado DENTRO del kernel (=y), no como módulo: MIKE OS no monta
# /lib/modules ni carga módulos al arrancar, así que un driver en módulo sería
# un driver que no existe. A cambio, no hace falta initramfs para llegar al
# disco raíz.
#
# Lo de fuera de la Surface (Intel, otras WiFi) va también: cuesta poco y
# evita que el sistema sólo sirva para un modelo concreto de portátil.
# =============================================================================

# --- Almacenamiento: sin esto no arranca en hardware real --------------------
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_SATA_AHCI=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# --- Gráficos AMD (Vega de Picasso/Renoir) -----------------------------------
# DRM_AMD_DC es el «Display Core»: sin él no hay salida de vídeo en las APU
# modernas. SI y CIK son para tarjetas de 2012-2014 y sólo engordan el kernel.
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_FP=y
CONFIG_DRM_AMD_DC_SI=n
CONFIG_DRM_AMDGPU_SI=n
CONFIG_DRM_AMDGPU_CIK=n
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- Procesador AMD: frecuencia, temperatura, GPIO ---------------------------
# PINCTRL_AMD no es opcional: de él cuelgan las interrupciones del touchpad y
# del teclado por I2C. Sin él la máquina arranca y no responde al tacto.
CONFIG_PINCTRL_AMD=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_SENSORS_K10TEMP=y
CONFIG_AMD_IOMMU=y
CONFIG_AMD_SFH_HID=y
# MICROCODE_AMD y MICROCODE_INTEL ya no son opciones sueltas en este kernel:
# van dentro de CONFIG_MICROCODE, que sí está.

# --- Surface Aggregator: el chip que gobierna el portátil --------------------
# En una Surface, el teclado, el touchpad, la batería, los ventiladores y las
# tapas no cuelgan del bus donde uno los buscaría, sino de un microcontrolador
# propio de Microsoft (SAM). Sin estos drivers, la máquina arranca perfecta y
# no puedes escribir.
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SURFACE_AGGREGATOR=y
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_CDEV=y
CONFIG_SURFACE_AGGREGATOR_HUB=y
CONFIG_SURFACE_AGGREGATOR_REGISTRY=y
CONFIG_SURFACE_AGGREGATOR_TABLET_SWITCH=y
CONFIG_SURFACE_ACPI_NOTIFY=y
CONFIG_SURFACE_HID=y
CONFIG_SURFACE_HID_CORE=y
CONFIG_SURFACE_KBD=y
CONFIG_SURFACE_DTX=y
CONFIG_SURFACE_PLATFORM_PROFILE=y
CONFIG_SURFACE_GPE=y
CONFIG_SURFACE_HOTPLUG=y
CONFIG_SURFACE_PRO3_BUTTON=y
CONFIG_BATTERY_SURFACE=y
CONFIG_CHARGER_SURFACE=y
CONFIG_SENSORS_SURFACE_TEMP=y
CONFIG_SENSORS_SURFACE_FAN=y
CONFIG_INPUT_SOC_BUTTON_ARRAY=y

# --- Entrada: teclado, touchpad y pantalla táctil ----------------------------
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_ELAN_I2C=y
CONFIG_HID_ELAN=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_APPLE=y

# --- Audio: AMD ACP (el camino de sonido de las APU Ryzen) -------------------
CONFIG_SND_SOC=y
CONFIG_SND_SOC_AMD_ACP=y
CONFIG_SND_SOC_AMD_ACP3x=y
CONFIG_SND_SOC_AMD_RENOIR=y
CONFIG_SND_SOC_AMD_RENOIR_MACH=y
CONFIG_SND_SOC_AMD_ACP_COMMON=y
# CONFIG_SND_SOC_AMD_RV_RT5682_MACH es para Chromebook con AMD: depende de
# CROS_EC, el controlador embebido de Chrome OS, que una Surface no tiene.
# El que vale aquí es RENOIR_MACH, que es el de estas APU.
CONFIG_SND_SOC_AMD_ACP5x=y
CONFIG_SND_SOC_AMD_ACP6x=y
CONFIG_SND_SOC_MAX98357A=y
CONFIG_SND_SOC_DMIC=y
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y

# --- Red inalámbrica ---------------------------------------------------------
# La Surface con AMD lleva Qualcomm (ath10k). Los demás van de propina para
# que la misma imagen sirva en otros portátiles.
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_ATH10K_SDIO=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_ATH9K=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLDVM=y
CONFIG_MT76x2E=y
CONFIG_MT7921E=y
CONFIG_RTW88=y
CONFIG_RTW89=y
CONFIG_BRCMFMAC=y

# --- Bluetooth ---------------------------------------------------------------
CONFIG_BT=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_LE=y

# --- Red por cable y adaptadores USB ----------------------------------------
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_R8169=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y

# --- USB-C, carga y muelles --------------------------------------------------
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_ACPI=y
CONFIG_TYPEC_DP_ALTMODE=y
CONFIG_USB4=y
CONFIG_USB_XHCI_PCI=y

# --- Energía: suspender, despertar y no quemarse -----------------------------
CONFIG_SUSPEND=y
CONFIG_PM=y
CONFIG_PM_AUTOSLEEP=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_VIDEO=y
CONFIG_ACPI_THERMAL=y
CONFIG_THERMAL=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
CONFIG_PM_DEVFREQ=y

# --- Cámara ------------------------------------------------------------------
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y

# --- Sistemas de archivos que uno se encuentra por ahí -----------------------
CONFIG_BTRFS_FS=y
CONFIG_F2FS_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_EXFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# =============================================================================
# AFINADO
#
# El objetivo es un portátil que responda, no un servidor que rinda de media.
# =============================================================================

# Un escritorio se juzga por el tirón al mover una ventana, no por cuántas
# compilaciones acaba en una hora: PREEMPT y 1000 Hz reparten el procesador en
# trozos más finos, que es lo que quita el tartamudeo.
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_IDLE=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_MC_PRIO=y

# El kernel comprimido con zstd descomprime bastante más rápido que con gzip,
# y eso se nota en el arranque, que es donde MIKE OS se juega su bandera.
CONFIG_KERNEL_ZSTD=y

# ZRAM: memoria comprimida en RAM en vez de swap en disco. En un portátil de
# 8 GB es la diferencia entre que se atragante o no al abrir el navegador, y
# sin castigar el SSD.
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_SWAP=y

# Planificadores de disco pensados para uso interactivo. BFQ prioriza lo que
# está esperando una persona delante; Kyber va mejor en NVMe.
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y

# Páginas grandes sólo cuando alguien las pide: activarlas siempre gasta
# memoria de más en un equipo que no va sobrado.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Fuera la información de depuración: son cientos de megas de símbolos que no
# sirven de nada en un sistema que no se depura desde dentro.
CONFIG_DEBUG_INFO_NONE=y

# El firmware (gráficos, WiFi) se carga desde /lib/firmware en disco, no
# empotrado en el kernel: así se actualiza sin recompilar.
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n

# --- Dependencias que faltaban ------------------------------------------------
# Diecinueve de las claves de arriba no llegaban al kernel porque les faltaba
# otra debajo. Se vieron comprobando el .config resultante clave por clave, no
# dando por hecho que "merge_config" las hubiera aplicado. La más grave era
# PINCTRL_AMD: sin GPIOLIB no entra, y sin PINCTRL_AMD no hay interrupciones
# de touchpad ni de teclado en una máquina AMD.
CONFIG_GPIOLIB=y
CONFIG_GPIO_ACPI=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_PINCTRL=y
CONFIG_COMMON_CLK=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_MICROCODE=y
CONFIG_USB_USBNET=y
CONFIG_USB_HID=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEOBUF2_VMALLOC=y
CONFIG_I2C=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=y
CONFIG_SND_SOC_SOF_AMD_TOPLEVEL=y

# --- Línea de órdenes dentro del propio kernel -------------------------------
# Sin esto la ISO no arranca, y el motivo no se ve por ninguna parte.
#
# El kernel con EFI_STUB es un ejecutable UEFI, sí, pero cuando la firmware lo
# arranca directamente (EFI/BOOT/BOOTX64.EFI) no le pasa NINGÚN argumento: no
# hay gestor de arranque que le diga dónde está la raíz ni qué initramfs
# cargar. El archivo cmdline.txt que dejaba el instalador no lo lee nadie: eso
# es cosa de la firmware de la Raspberry Pi, no de UEFI.
#
# Resultado: la firmware cargaba el kernel, el kernel se quedaba sin raíz y sin
# consola serie configurada, y por fuera parecía que la ISO ni arrancaba.
#
# Con la línea de órdenes compilada dentro, el kernel se basta solo: sabe que
# su raíz está en RAM y carga el initramfs del mismo volumen EFI. Sin FORCE,
# para que un gestor de arranque pueda seguir pasando la suya cuando lo haya
# (el sistema ya instalado en disco sí la recibe).
CONFIG_CMDLINE_BOOL=y
# El ORDEN de los console= importa: el último se lleva /dev/console, que es
# adonde va la salida de espacio de usuario. Estaba ttyS0 al final, así que en
# cualquier equipo sin puerto serie -- o sea, cualquier portátil -- todo lo que
# escribiera el sistema se iba a un puerto que no existe. Ahora manda la
# pantalla; el serie sigue recibiendo los mensajes del kernel, que es lo que
# necesitan las pruebas automáticas.
CONFIG_CMDLINE="initrd=\\EFI\\BOOT\\initramfs.cpio.gz root=/dev/ram0 rw console=ttyS0 console=tty0 mikeos_gui=1"

# =============================================================================
# EL BUS DEL QUE CUELGAN EL TECLADO Y EL TOUCHPAD DE UN PORTÁTIL
#
# Esto es por qué en una Surface Laptop 4 arrancaba todo y no se podía
# escribir: había que enchufar un teclado USB. El teclado USB funcionaba
# porque cuelga de un bus estándar (xHCI); el de dentro, no.
#
# En un portátil moderno el teclado y el touchpad no van por el puerto PS/2 de
# toda la vida. Cuelgan de controladores I2C/UART de baja potencia que la ACPI
# declara con un identificador del fabricante -- AMDI0010 (I2C) y AMDI0020
# (UART) en una APU Ryzen -- y que NO son dispositivos PCI: nadie los
# enumera solo. Alguien tiene que leer la tabla ACPI, crear el dispositivo de
# plataforma y, sobre todo, decirle a qué frecuencia va su reloj (48 MHz el
# UART, 133 MHz el I2C). Ese alguien es drivers/acpi/acpi_apd.c, y el
# archivo entero está dentro de un #ifdef CONFIG_X86_AMD_PLATFORM_DEVICE.
#
# Sin esa clave la cadena se rompe desde el primer eslabón:
#
#   sin acpi_apd -> no hay dispositivo para AMDI0020
#                -> 8250_dw no tiene a qué engancharse, no hay puerto serie
#                -> serdev no tiene puerto, no hay bus
#                -> SURFACE_AGGREGATOR nunca encuentra el microcontrolador
#                -> no hay teclado, ni touchpad, ni batería, ni ventiladores
#
# Y los cinco eslabones de abajo SÍ estaban puestos (=y), que es lo que hacía
# esto tan difícil de ver: el .config decía que el teclado de la Surface
# estaba soportado, y era verdad salvo por la pieza que sostiene todo lo demás.
#
# Se comprueba con:  grep X86_AMD_PLATFORM_DEVICE kernel/.config
CONFIG_X86_AMD_PLATFORM_DEVICE=y

# Lo mismo para Intel: sus controladores I2C/UART de baja potencia (LPSS) son
# el equivalente exacto de lo de arriba. Sin esto, un portátil Intel de los
# últimos diez años arranca igual de mudo que la Surface.
CONFIG_MFD_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_SERIAL_8250_LPSS=y
CONFIG_SERIAL_8250_MID=y

# El touchpad por I2C avisa de que hay algo que leer con una interrupción por
# GPIO. El driver del I2C sin el del GPIO es un touchpad que se detecta, se
# registra, y no manda nada nunca: el puntero no se mueve y parece que el
# touchpad está roto. PINCTRL_AMD ya estaba; faltaba el lado Intel entero.
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y

# En las Surface con Intel, parte de los sensores y botones van por el ISH, un
# procesador aparte dedicado a eso.
CONFIG_INTEL_ISH_HID=y
CONFIG_HID_SENSOR_HUB=y

# Gestión de energía de las APU AMD modernas. AMD_PMC es además lo que permite
# que el equipo entre en el modo de suspensión que de verdad usan estos
# portátiles; sin él, cerrar la tapa gasta batería como si estuviera abierto.
CONFIG_AMD_PMC=y
CONFIG_AMD_PMF=y

# --- Firmware comprimido y más hardware ---------------------------------------
#
# El kernel sabe leer firmware comprimido con zstd directamente. Hasta ahora se
# descomprimía al construir la imagen "porque se carga más rápido", y eso
# costaba entre dos y tres veces más espacio en cada archivo. Con esta clave se
# copian tal cual vienen: cabe el triple de hardware soportado en el mismo
# tamaño, y la diferencia al arrancar es de milisegundos.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# NVIDIA. nouveau es el driver libre, y va dentro del kernel como todo lo demás.
#
# Cubre por completo las tarjetas anteriores a Turing (serie GTX 900 y 1000, y
# las móviles equivalentes) con un firmware que ocupa 4 MB. De Turing en
# adelante (RTX 20, 30, 40) nouveau necesita además el "GSP", que son 112 MB de
# blobs: eso no cabe en una imagen de instalación y se instala aparte con
# "mpm install linux-firmware-nvidia". En un portátil con NVIDIA eso no deja a
# nadie sin pantalla, porque la pantalla la mueve la gráfica integrada.
CONFIG_DRM_NOUVEAU=y

# Red por cable: las controladoras que uno se encuentra de verdad en placas y
# adaptadores USB. Antes sólo estaban Intel y Realtek de sobremesa, así que un
# portátil con Broadcom o Atheros se quedaba sin cable Y sin wifi a la vez.
CONFIG_ATL1C=y
CONFIG_ATL1E=y
CONFIG_ALX=y
# Se llamaba TG3 y no existe: el símbolo es TIGON3. Con el nombre mal, el
# Ethernet Broadcom (Dell, HP y Lenovo de empresa) no estuvo nunca.
CONFIG_TIGON3=y
CONFIG_BNX2=y
CONFIG_SKY2=y
CONFIG_VIA_RHINE=y
CONFIG_8139CP=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_NET_DM9601=y
CONFIG_USB_NET_SR9800=y
CONFIG_USB_RTL8150=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_NET_CDC_SUBSET=y
CONFIG_USB_IPHETH=y

# Wi-Fi: el resto de las familias que llevan los portátiles. iwlwifi ya estaba;
# faltaban las de Qualcomm modernas, MediaTek y Realtek.
# (ATH11K_AHB fuera: es el bus de los routers Qualcomm IPQ, no existe en x86.)
CONFIG_ATH12K=y
CONFIG_MT7601U=y
CONFIG_MT76x0U=y
CONFIG_MT76x2U=y
CONFIG_MT7663U=y
CONFIG_MT7921U=y
CONFIG_MT7925E=y
CONFIG_RTL8187=y
CONFIG_RTL8XXXU=y
CONFIG_RTLWIFI_PCI=y
CONFIG_RTL8192CE=y
CONFIG_RTL8821AE=y
CONFIG_BRCMFMAC_USB=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_MWIFIEX=y
CONFIG_MWIFIEX_PCIE=y
CONFIG_MWIFIEX_USB=y

# =============================================================================
# ENERGÍA, ESTABILIDAD Y RENDIMIENTO
#
# Hasta aquí el kernel arrancaba con los valores de fábrica para casi todo lo
# que decide cuánto dura la batería y cuánto se calienta el equipo. En un
# portátil eso se nota en horas.
# =============================================================================

# --- Suspender y despertar ---------------------------------------------------
# S0ix ("suspensión moderna") es lo que usan los portátiles actuales, y lo que
# espera la firmware de una Surface. Sin ACPI_SLEEP no hay suspensión de
# ninguna clase.
CONFIG_ACPI_SLEEP=y
# (SUSPEND_FREEZE fuera: desapareció del kernel; suspender a RAM ya va con SUSPEND.)
CONFIG_PM_SLEEP=y
CONFIG_PM_SLEEP_SMP=y
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_TRACE_RTC=y
CONFIG_ACPI_PROCESSOR_IDLE=y
CONFIG_X86_ACPI_CPUFREQ_CPB=y

# Hibernar al disco, para cuando la batería se acaba de verdad.
CONFIG_HIBERNATION=y

# --- Ahorro de energía por dispositivo ---------------------------------------
# Sin PCIEASPM el bus PCI Express se queda a plena potencia siempre, y es de
# las cosas que más consumen en reposo.
CONFIG_PCIEASPM=y
CONFIG_PCIEASPM_POWERSAVE=y
CONFIG_PM_ADVANCED_DEBUG=n
# (USB_PM fuera: ya no existe; la gestión de energía USB va siempre con PM.)
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=10
CONFIG_SATA_MOBILE_LPM_POLICY=3

# --- Térmica -----------------------------------------------------------------
# Sin esto el equipo no reduce la frecuencia al calentarse: sube de temperatura
# hasta que el hardware se protege solo, que es brusco y se nota.
# (THERMAL_GOV_POWER_ALLOCATOR fuera: exige ENERGY_MODEL, que en x86 no usa nadie.)
# (CPU_THERMAL fuera: depende de THERMAL_OF, que es sólo para Device Tree/ARM.)
CONFIG_DEVFREQ_THERMAL=y
CONFIG_X86_PKG_TEMP_THERMAL=y
# ACPI_THERMAL_REL no se puede pedir directamente: no tiene menú, lo arrastra
# INT340X_THERMAL (ver el bloque de compatibilidad al final).

# --- Estabilidad -------------------------------------------------------------
# Si el kernel se queda colgado de verdad, mejor reiniciar a los 30 segundos
# que dejar el equipo muerto esperando a que alguien mantenga el botón.
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=0
CONFIG_PANIC_TIMEOUT=30
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
# El "OOM killer" avisa antes de matar procesos, para que quede en el registro
# por qué se cerró una aplicación sola.
CONFIG_MEMCG=y

# --- Rendimiento -------------------------------------------------------------
# Reloj de alta resolución y temporizadores sin tick en reposo: menos
# interrupciones, menos consumo y menos tirones.
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_FULL=n
# La memoria comprimida con LZ4 se descomprime bastante más rápido que zstd, y
# en swap lo que importa es la latencia, no cuánto comprime.
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=n
# El planificador de bloque por defecto para discos rápidos.
CONFIG_MQ_IOSCHED_DEADLINE=y
# Para juegos y aplicaciones que usan mucha sincronización entre hilos.
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y

# ==============================================================================
# Compatibilidad: lo que faltaba para que MIKE OS arranque en más equipos
# ==============================================================================
#
# Aquí todo va compilado dentro (=y): no se monta /lib/modules, así que un
# driver en módulo es un driver que no existe. Y "olddefconfig" tira EN
# SILENCIO lo que se pide si le falta una dependencia --- por eso cada grupo de
# abajo lleva también lo que necesita para quedarse. tests/kernel-config.sh
# comprueba que todo lo pedido en este archivo acaba de verdad en el kernel.

# --- Instalar: el disco tiene que verse -------------------------------------
# Intel VMD ("RST" en la BIOS) viene ACTIVADO de fábrica en muchos portátiles
# Intel desde la 11.ª generación. Sin este driver el NVMe queda escondido
# detrás del controlador: el instalador dice que no hay ningún disco.
CONFIG_VMD=y

# --- Instalar: el menú de arranque de la UEFI -------------------------------
# efibootmgr escribe a través de efivarfs. Iba como módulo, o sea: no estaba.
# El instalador no podía registrar MIKE OS y, al lado de Windows, el equipo
# seguía arrancando Windows después de instalar.
CONFIG_EFIVAR_FS=y

# --- Gráficas -----------------------------------------------------------------
# xe es el ÚNICO driver de las Intel Lunar Lake (Core Ultra 200V) y Arc
# Battlemage: i915 no las reconoce. Sin él, pantalla en simpledrm y sin
# aceleración. Por defecto sólo se engancha a lo que i915 no lleva, así que no
# compiten.
CONFIG_DRM_XE=y
# radeon lleva las AMD anteriores a GCN y, como este fragmento quita SI y CIK
# de amdgpu, también las HD 7000 y R7/R9 200. Sin esto esas tarjetas no tenían
# NINGÚN driver.
CONFIG_DRM_RADEON=y

# --- Wi-Fi ------------------------------------------------------------------------
# Intel BE200/BE201 (Wi-Fi 7, el estándar en portátiles desde 2024) usan el
# modo de operación nuevo de iwlwifi. Con sólo IWLMVM la tarjeta se detecta y
# no llega a funcionar.
CONFIG_IWLMLD=y

# --- Ethernet --------------------------------------------------------------------
# Intel I225/I226 (2,5 Gb): la de casi todas las placas de sobremesa y mini PC
# desde 2020.
CONFIG_IGC=y
# Compartir internet desde el móvil por USB. m-drivers recomienda exactamente
# esto cuando no hay red, y Android antiguo usa RNDIS e iPhone su propio
# protocolo: sin estos dos, el consejo no funcionaba.
CONFIG_USB_NET_RNDIS_HOST=y

# --- Lectores de tarjetas SD de Realtek (casi todos los portátiles) ------------
CONFIG_MISC_RTSX_PCI=y
CONFIG_MMC_REALTEK_PCI=y

# --- Touchpads ---------------------------------------------------------------
# Sin estos, los touchpads Elantech y Synaptics (Asus, Acer, Lenovo, HP)
# funcionan como un ratón PS/2 de 1995: sin dos dedos, sin desplazamiento.
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ELANTECH_SMBUS=y
CONFIG_MOUSE_PS2_SYNAPTICS_SMBUS=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_SMB=y
CONFIG_RMI4_F3A=y
# Receptores Logitech Unifying/Bolt: sin el driver propio, varios ratones y
# teclados se quedan sin botones extra o directamente sin emparejar.
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y

# --- Sonido en portátiles AMD e Intel modernos -------------------------------
# Micrófono interno de Ryzen 6000 (ACP6x/YC) y Ryzen 7040/8040 (Pink Sardine).
CONFIG_SND_SOC_AMD_YC_MACH=y
CONFIG_SND_SOC_AMD_PS=y
CONFIG_SND_SOC_AMD_PS_MACH=y
CONFIG_SND_SOC_SOF_AMD_REMBRANDT=y
# Amplificadores de los altavoces (Cirrus y TI) de muchos Lenovo, ASUS, HP y
# Dell: sin ellos el códec funciona pero los altavoces no suenan.
CONFIG_SND_HDA_SCODEC_CS35L41_I2C=y
CONFIG_SND_HDA_SCODEC_CS35L56_I2C=y
CONFIG_SND_HDA_SCODEC_TAS2781_I2C=y

# --- Temperatura y energía --------------------------------------------------
# Intel DPTF: lo que mantiene a raya la temperatura en portátiles Intel.
CONFIG_INT340X_THERMAL=y
# AMD PMF (perfiles de energía de los Ryzen portátiles modernos). Se caía en
# silencio porque exige el TEE de AMD, que exige el coprocesador CCP/PSP.
CONFIG_TEE=y
CONFIG_CRYPTO_DEV_CCP=y
CONFIG_CRYPTO_DEV_CCP_DD=y
CONFIG_CRYPTO_DEV_SP_PSP=y
CONFIG_AMDTEE=y

# --- VirtualBox ---------------------------------------------------------------
# VBOXGUEST se caía en silencio: vive dentro del menú VIRT_DRIVERS.
CONFIG_VIRT_DRIVERS=y

# --- Sensores (pantallas que giran, brillo automático) y Toshiba ----------------
# HID_SENSOR_HUB ya estaba, pero sin IIO nadie podía leer los sensores.
CONFIG_IIO=y
CONFIG_HID_SENSOR_ACCEL_3D=y
CONFIG_HID_SENSOR_ALS=y
CONFIG_HID_SENSOR_GYRO_3D=y

# --- Drivers de cada marca de portátil -------------------------------------------
# No había NINGUNO salvo el de Surface. Son los que dan las teclas de brillo,
# volumen, micro y modo avión, la retroiluminación del teclado, el límite de
# carga de la batería y los perfiles de ventilador. En los IdeaPad, sin
# ideapad-laptop el Wi-Fi puede quedarse bloqueado y no hay quien lo suelte.
CONFIG_THINKPAD_ACPI=y
CONFIG_IDEAPAD_LAPTOP=y
CONFIG_ASUS_WMI=y
CONFIG_ASUS_NB_WMI=y
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_HP_WMI=y
CONFIG_ACER_WMI=y
CONFIG_MSI_WMI=y
CONFIG_SAMSUNG_LAPTOP=y
CONFIG_LG_LAPTOP=y
CONFIG_HUAWEI_WMI=y
CONFIG_GIGABYTE_WMI=y
CONFIG_FUJITSU_LAPTOP=y
CONFIG_SONY_LAPTOP=y
CONFIG_PANASONIC_LAPTOP=y
CONFIG_ACPI_TOSHIBA=y
# Dell: DCDBAS vale "m" por defecto y, como todo Dell depende de él con
# "DCDBAS || DCDBAS=n", arrastraba al resto a módulo.
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_DCDBAS=y
CONFIG_DELL_SMBIOS=y
CONFIG_DELL_SMBIOS_WMI=y
CONFIG_DELL_SMBIOS_SMM=y
CONFIG_DELL_WMI=y
CONFIG_DELL_LAPTOP=y

# --- Cortafuegos y NAT ---------------------------------------------------------
# Iban como módulos: iptables con MASQUERADE, LOG o REJECT fallaba.
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_LOG_ARP=y
CONFIG_NF_LOG_IPV4=y
CONFIG_NF_LOG_IPV6=y
CONFIG_NF_REJECT_IPV4=y
CONFIG_NF_REJECT_IPV6=y
# Los extras de Dell que valen la pena: tecla de modo avión, perfiles de
# ventilador, salud de la batería, LED del micro y los Alienware/Dell G.
CONFIG_DELL_RBTN=y
CONFIG_DELL_PC=y
CONFIG_DELL_WMI_DDV=y
CONFIG_DELL_WMI_LED=y
CONFIG_DELL_WMI_AIO=y
CONFIG_DELL_SMO8800=y
CONFIG_ALIENWARE_WMI=y
# Y los que no. DELL_RBU (actualizar la BIOS desde el sistema) vale "m" por
# defecto y arrastra FW_LOADER_USER_HELPER, que este fragmento apaga a
# propósito más arriba. Cambiar la configuración de la BIOS desde el sistema
# (SYSMAN, BIOSCFG) tampoco: es una puerta que no hace falta abrir.
CONFIG_DELL_RBU=n
CONFIG_DELL_WMI_SYSMAN=n
CONFIG_HP_BIOSCFG=n
CONFIG_HP_ACCEL=n

# --- Lo que quedaba como módulo, decidido uno a uno ---------------------------
# Un "=m" aquí no es "opcional": es "no está". Mejor decirlo.
CONFIG_IPV6_SIT=n
CONFIG_DRM_NOUVEAU_CH7006=n
CONFIG_DRM_NOUVEAU_SIL164=n
CONFIG_CRYPTO_DEV_CCP_CRYPTO=n

# --- Nombre de la versión -----------------------------------------------------
# "7.2.9-mikeos" en vez de "7.2.9-dirty". El sufijo automático de git marca
# como "sucio" cualquier árbol con cambios sin confirmar, y aquí siempre los
# hay: son los parches de build/kernel-patches/. (build.sh compila además con
# LOCALVERSION definida, que es lo que quita el "+" final.)
CONFIG_LOCALVERSION="-mikeos"
CONFIG_LOCALVERSION_AUTO=n
