# ------------------------------------------------------------------ registro
#
# Cada componente encontrado se apunta como una fila con campos separados por
# tabulador. Así el informe de texto y el JSON salen de los MISMOS datos, y no
# puede pasar que el panel diga una cosa y la terminal otra.
componente() {  # categoría | nombre | estado | detalle
    printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >> "$FILAS"
}

proponer() {  # paquete | por qué
    case " $INSTALAR " in *" $1 "*) return ;; esac
    is_instalado "$1" && return
    INSTALAR="$INSTALAR $1"
    printf 'PAQUETE\t%s\t%s\t%s\n' "$1" "propuesto" "$2" >> "$FILAS"
}

# ================================================================== gráfica
buscar_graficas() {
    for _d in "$PCI"/*; do
        [ -d "$_d" ] || continue
        case "$(leer_hex "$_d/class")" in 03*) ;; *) continue ;; esac
        _id="$(basename "$_d")"
        _v="$(leer_hex "$_d/vendor")"; _p="$(leer_hex "$_d/device")"
        _nom="$(nombre_dispositivo "$_v" "$_p")"
        _drv="$(basename "$(readlink -f "$_d/driver" 2>/dev/null)" 2>/dev/null)"
        _fw="$(firmware_que_falta "$_id")"
        if [ -z "$_drv" ] || [ "$_drv" = "." ]; then
            if [ -n "$_fw" ]; then
                componente "$(t Gráfica)" "$_nom" "sin-firmware" "$(t 'le falta %s' "$_fw")"
            else
                componente "$(t Gráfica)" "$_nom" "sin-driver" "$(t 'el kernel no la reconoce')"
            fi
        else
            componente "$(t Gráfica)" "$_nom" "ok" "$(t 'driver %s' "$_drv")"
        fi
        case "$_v" in
            10de) proponer nvidia-open  "$(t 'controlador NVIDIA (Turing en adelante)')"
                  proponer nvidia-utils "$(t 'bibliotecas OpenGL/Vulkan de NVIDIA')" ;;
            1002) proponer vulkan-radeon     "$(t 'Vulkan para AMD')"
                  proponer libva-mesa-driver "$(t 'aceleración de vídeo AMD')" ;;
            8086) proponer vulkan-intel       "$(t 'Vulkan para Intel')"
                  proponer intel-media-driver "$(t 'aceleración de vídeo Intel')" ;;
            1af4|1234) proponer vulkan-virtio "$(t 'Vulkan en máquina virtual (Venus)')" ;;
        esac
    done
}

# ====================================================================== red
buscar_red() {
    # Por PCI: la Ethernet y la Wi-Fi integradas.
    for _d in "$PCI"/*; do
        [ -d "$_d" ] || continue
        case "$(leer_hex "$_d/class")" in 02*|0d*) ;; *) continue ;; esac
        _id="$(basename "$_d")"
        _v="$(leer_hex "$_d/vendor")"; _p="$(leer_hex "$_d/device")"
        _nom="$(nombre_dispositivo "$_v" "$_p")"
        _drv="$(basename "$(readlink -f "$_d/driver" 2>/dev/null)" 2>/dev/null)"
        _fw="$(firmware_que_falta "$_id")"
        # ¿Le salió interfaz? Es la prueba de que funciona de verdad.
        #
        # Y hay que buscarla DOS niveles: en una tarjeta normal cuelga de
        # ".../0000:04:00.0/net/enp4s0", pero en virtio (o sea, en toda máquina
        # virtual) hay un bus intermedio y queda en ".../virtio0/net/eth0".
        # Mirando sólo el primer nivel, el informe decía "driver virtio-pci,
        # sin interfaz" en una máquina que tenía red, IP y DNS funcionando.
        _iface=""
        for _n in "$_d"/net/* "$_d"/*/net/*; do
            [ -d "$_n" ] && _iface="$(basename "$_n")"
        done
        if [ -n "$_iface" ]; then
            _ip="$(ip -4 addr show "$_iface" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)"
            if [ -n "$_ip" ]; then
                componente "$(t Red)" "$_nom" "ok" "$(t '%s con %s' "$_iface" "$_ip")"
            else
                componente "$(t Red)" "$_nom" "apagado" "$(t '%s sin dirección IP' "$_iface")"
            fi
        elif [ -n "$_fw" ]; then
            componente "$(t Red)" "$_nom" "sin-firmware" "$(t 'le falta %s' "$_fw")"
        elif [ -z "$_drv" ] || [ "$_drv" = "." ]; then
            componente "$(t Red)" "$_nom" "sin-driver" "$(t 'el kernel no la reconoce')"
        else
            componente "$(t Red)" "$_nom" "apagado" "$(t 'driver %s, sin interfaz' "$_drv")"
        fi
        # El paquete de firmware SÓLO se propone si a esta tarjeta le falta
        # algo de verdad. Antes se proponía por el fabricante, así que un
        # equipo con la Wi-Fi funcionando perfectamente salía recomendando
        # descargar 90 MB de firmware que no iba a usar -- y eso era justo lo
        # que hacía que la pantalla de bienvenida siguiera pidiendo instalar
        # controladores después de haberlos instalado.
        if [ -n "$_fw" ] || [ -z "$_drv" ] || [ "$_drv" = "." ]; then
            case "$_v" in
                8086)      proponer firmware-extra "$(t 'firmware de Wi-Fi Intel completo')" ;;
                14e4)      proponer broadcom-wl    "$(t 'controlador Wi-Fi Broadcom')" ;;
                168c|17cb) proponer firmware-extra "$(t 'firmware Atheros/Qualcomm')" ;;
                14c3)      proponer firmware-extra "$(t 'firmware Wi-Fi MediaTek')" ;;
            esac
        fi
    done

    # Por USB: los adaptadores de red que se enchufan, y el móvil compartiendo
    # internet. Este bloque faltaba entero.
    for _d in "$USB"/*:*; do
        [ -d "$_d" ] || continue
        _cl="$(cat "$_d/bInterfaceClass" 2>/dev/null || echo '')"
        # 02 = comunicaciones (ethernet USB, móvil anclado), ff = propietario
        case "$_cl" in 02) ;; *) continue ;; esac
        _iface=""
        for _n in "$_d"/net/*; do [ -d "$_n" ] && _iface="$(basename "$_n")"; done
        _padre="$(dirname "$_d")/$(basename "$_d" | cut -d: -f1)"
        _nom="$(cat "$_padre/product" 2>/dev/null || echo 'Adaptador de red USB')"
        if [ -n "$_iface" ]; then
            componente "$(t Red)" "$_nom" "ok" "$(t 'USB, %s' "$_iface")"
        else
            componente "$(t Red)" "$_nom" "sin-driver" "$(t 'USB, sin interfaz de red')"
        fi
    done
}

# ================================================================ bluetooth
#
# Este apartado no existía. El Bluetooth es el componente que más veces se
# queda a medias --- el driver se engancha y luego falla al cargar el firmware,
# así que desde /sys parece que está bien --- y era justo el que no se miraba.
buscar_bluetooth() {
    _hay=0

    # Adaptadores que YA funcionan: tienen su hci.
    for _h in /sys/class/bluetooth/hci*; do
        [ -d "$_h" ] || continue
        _hay=1
        _hci="$(basename "$_h")"
        _nom="$(cat "$_h/device/../product" 2>/dev/null || echo 'Adaptador Bluetooth')"

        # ¿Bloqueado por software? Sin udev nadie restaura rfkill y en muchos
        # equipos arranca bloqueado: idéntico a no tener adaptador.
        _bloqueado=0
        for _r in /sys/class/rfkill/rfkill*; do
            [ -d "$_r" ] || continue
            [ "$(cat "$_r/type" 2>/dev/null)" = "bluetooth" ] || continue
            [ "$(cat "$_r/soft" 2>/dev/null)" = "1" ] && _bloqueado=1
        done

        if [ "$_bloqueado" = 1 ]; then
            componente "$(t Bluetooth)" "$_nom" "apagado" "$(t '%s bloqueado por software' "$_hci")"
        elif ! servicio_vivo bluetoothd; then
            componente "$(t Bluetooth)" "$_nom" "apagado" "$(t '%s detectado, bluetoothd caído' "$_hci")"
        else
            componente "$(t Bluetooth)" "$_nom" "ok" "$_hci"
        fi
    done

    # Adaptadores USB que el sistema ve pero que no llegaron a dar un hci: es
    # el caso del firmware que no estaba al arrancar.
    for _d in "$USB"/*:*; do
        [ -d "$_d" ] || continue
        # Clase e0, subclase 01, protocolo 01: adaptador Bluetooth. Es
        # estándar y lo cumplen todos, Intel incluido.
        [ "$(cat "$_d/bInterfaceClass" 2>/dev/null || echo '')" = "e0" ] || continue
        [ "$(cat "$_d/bInterfaceSubClass" 2>/dev/null || echo '')" = "01" ] || continue
        [ "$_hay" = 1 ] && continue
        _hay=1
        _id="$(basename "$_d")"
        _padre="$(dirname "$_d")/$(echo "$_id" | cut -d: -f1)"
        _nom="$(cat "$_padre/product" 2>/dev/null || echo 'Adaptador Bluetooth USB')"
        _fw="$(firmware_que_falta "$_id")"
        [ -z "$_fw" ] && _fw="$(firmware_que_falta 'hci0')"
        if [ -n "$_fw" ]; then
            componente "$(t Bluetooth)" "$_nom" "sin-firmware" "$(t 'le falta %s' "$_fw")"
            proponer firmware-extra "$(t 'firmware de Bluetooth que falta')"
        else
            componente "$(t Bluetooth)" "$_nom" "sin-driver" "$(t 'detectado, sin adaptador hci')"
        fi
    done

    [ "$_hay" = 1 ] || componente "$(t Bluetooth)" "$(t 'Sin adaptador')" "ausente" "$(t 'este equipo no tiene Bluetooth')"
}

# =================================================================== sonido
buscar_sonido() {
    _hay=0
    if [ -r /proc/asound/cards ]; then
        while IFS= read -r _l; do
            case "$_l" in
                *']:'*)
                    _hay=1
                    _nom="${_l#*]: }"
                    _n="$(echo "$_l" | sed -n 's/^ *\([0-9]*\) .*/\1/p')"
                    # ¿Tiene salida de verdad? Un códec sin PCM de reproducción
                    # aparece en la lista y no suena.
                    if ls /proc/asound/card"$_n"/pcm*p >/dev/null 2>&1; then
                        componente "$(t Sonido)" "$_nom" "ok" "$(t 'tarjeta %s con salida' "$_n")"
                    else
                        componente "$(t Sonido)" "$_nom" "apagado" "$(t 'tarjeta %s sin salida de audio' "$_n")"
                    fi
                    ;;
            esac
        done < /proc/asound/cards
    fi
    if [ "$_hay" = 0 ]; then
        componente "$(t Sonido)" "$(t 'Sin tarjeta')" "sin-driver" "$(t 'no hay ninguna tarjeta registrada')"
    elif ! proceso_vivo pipewire; then
        componente "$(t Sonido)" "$(t 'Servidor de audio')" "apagado" "$(t 'pipewire no está en marcha')"
    fi
}

# ================================================================== entrada
buscar_entrada() {
    _t=0; _tp=0
    for _n in /sys/class/input/input*/name; do
        [ -r "$_n" ] || continue
        _nom="$(cat "$_n" 2>/dev/null)"
        case "$_nom" in
            *[Tt]ouchpad*|*[Tt]rackpad*) componente "$(t Entrada)" "$_nom" "ok" "$(t 'panel táctil')"; _tp=1 ;;
            *[Tt]ouch*|*[Ss]tylus*|*[Ww]acom*|*[Pp]en*) componente "$(t Entrada)" "$_nom" "ok" "$(t 'pantalla táctil o tableta')"; _t=1 ;;
        esac
    done
    [ "$_t" = 1 ] || [ "$_tp" = 1 ] || componente "$(t Entrada)" "$(t 'Teclado y ratón')" "ok" "$(t 'sin pantalla táctil ni panel')"
}

# ==================================================================== cámara
buscar_camara() {
    _hay=0
    for _v in /dev/video*; do
        [ -e "$_v" ] || continue
        _hay=1
        _nom="$(cat "/sys/class/video4linux/$(basename "$_v")/name" 2>/dev/null || basename "$_v")"
        componente "$(t Cámara)" "$_nom" "ok" "$_v"
    done
    if [ "$_hay" = 0 ]; then
        # ¿Hay una cámara USB que no llegó a dar /dev/video? Clase 0e = vídeo.
        for _d in "$USB"/*:*; do
            [ -d "$_d" ] || continue
            [ "$(cat "$_d/bInterfaceClass" 2>/dev/null || echo '')" = "0e" ] || continue
            _padre="$(dirname "$_d")/$(basename "$_d" | cut -d: -f1)"
            componente "$(t Cámara)" \
                       "$(cat "$_padre/product" 2>/dev/null || t 'Cámara USB')" \
                       "sin-driver" "$(t 'detectada, sin /dev/video')"
            _hay=1
            break
        done
    fi
    [ "$_hay" = 1 ] || componente "$(t Cámara)" "$(t 'Sin cámara')" "ausente" "$(t 'no se encontró ninguna')"
}

# =============================================================== almacenamiento
buscar_discos() {
    for _b in /sys/block/*; do
        [ -d "$_b" ] || continue
        _n="$(basename "$_b")"
        case "$_n" in loop*|ram*|zram*|dm-*|sr*) continue ;; esac
        _tam="$(cat "$_b/size" 2>/dev/null || echo 0)"
        [ "$_tam" -gt 0 ] 2>/dev/null || continue
        _gb=$(( _tam / 2097152 ))
        # Los discos virtio y muchos NVMe no tienen "model". Sin esto salía
        # "vda — vda, 10 GB": el mismo dato dos veces y ningún nombre.
        _mod="$(cat "$_b/device/model" 2>/dev/null || true)"
        [ -n "$_mod" ] || _mod="$(cat "$_b/device/modelo" 2>/dev/null || true)"
        if [ -z "$_mod" ]; then
            # Estos nombres los inventamos nosotros (el hardware no dice
            # ninguno), así que también se traducen. Los de los discos que SÍ
            # traen "model" no: ahí pone lo que puso el fabricante.
            case "$_n" in
                nvme*)  _mod="$(t 'Disco NVMe')" ;;
                vd*)    _mod="$(t 'Disco virtual')" ;;
                mmcblk*) _mod="$(t 'Tarjeta o memoria eMMC')" ;;
                *)      _mod="$(t Disco)" ;;
            esac
        fi
        componente "$(t Almacenamiento)" "$_mod" "ok" "$(t '%s, %s GB' "$_n" "$_gb")"
    done
}

# ================================================================ procesador
buscar_cpu() {
    _cpu="$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo 2>/dev/null | head -1)"
    [ -n "$_cpu" ] || _cpu="$(t 'Procesador desconocido')"
    _gob="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo '')"
    if [ -n "$_gob" ]; then
        componente "$(t Procesador)" "$_cpu" "ok" "$(t 'gobernador %s' "$_gob")"
    else
        componente "$(t Procesador)" "$_cpu" "mejorable" "$(t 'sin control de frecuencia')"
    fi
    case "$(sed -n 's/^vendor_id[[:space:]]*: //p' /proc/cpuinfo 2>/dev/null | head -1)" in
        GenuineIntel) proponer intel-ucode "$(t 'actualizaciones de microcódigo Intel')" ;;
        AuthenticAMD) proponer amd-ucode   "$(t 'actualizaciones de microcódigo AMD')" ;;
    esac
}

# ===================================================================== batería
buscar_bateria() {
    for _b in /sys/class/power_supply/BAT*; do
        [ -d "$_b" ] || continue
        componente "$(t Batería)" \
                   "$(cat "$_b/model_name" 2>/dev/null || basename "$_b")" "ok" \
                   "$(t '%s%% — %s' "$(cat "$_b/capacity" 2>/dev/null || echo '?')" \
                                    "$(cat "$_b/status"   2>/dev/null || echo '?')")"
    done
}

escanear() {
    buscar_graficas
    buscar_red
    buscar_bluetooth
    buscar_sonido
    buscar_entrada
    buscar_camara
    buscar_discos
    buscar_cpu
    buscar_bateria
}

# ===================================================================== salida
texto() {
    # El subrayado se calcula, no se escribe: "Hardware detectado" y
    # "Hardware detected" no miden lo mismo, y una raya que no llega hasta el
    # final del título se ve como un error de formato.
    _tit="$(t 'Hardware detectado')"
    echo "$_tit"
    printf '%s\n' "$_tit" | tr -c '\n' '='
    _cat=""
    while IFS="$(printf '\t')" read -r _c _n _e _d; do
        [ "$_c" = "PAQUETE" ] && continue
        if [ "$_c" != "$_cat" ]; then
            _cat="$_c"
            printf '\n%s\n' "$_c"
        fi
        case "$_e" in
            ok)           _m="  ✓" ;;
            sin-driver)   _m="  ✗" ;;
            sin-firmware) _m="  !" ;;
            apagado)      _m="  ·" ;;
            *)            _m="  ·" ;;
        esac
        printf '%s %s\n' "$_m" "$_n"
        [ -n "$_d" ] && printf '      %s\n' "$_d"
    done < "$FILAS"
    echo

    if [ -z "$INSTALAR" ]; then
        t 'No hace falta instalar nada: el sistema ya cubre este equipo.'
        echo
        return
    fi
    _tit="$(t Recomendado)"
    echo "$_tit"
    printf '%s\n' "$_tit" | tr -c '\n' '='
    while IFS="$(printf '\t')" read -r _c _n _e _d; do
        [ "$_c" = "PAQUETE" ] || continue
        printf '    %-20s %s\n' "$_n" "$_d"
    done < "$FILAS"
    echo
}

json() {
    printf '{"componentes":['
    _pri=1
    while IFS="$(printf '\t')" read -r _c _n _e _d; do
        [ "$_c" = "PAQUETE" ] && continue
        [ "$_pri" = 1 ] || printf ','
        _pri=0
        printf '{"categoria":"%s","nombre":"%s","estado":"%s","detalle":"%s"}' \
            "$(escapar "$_c")" "$(escapar "$_n")" "$_e" "$(escapar "$_d")"
    done < "$FILAS"
    printf '],"paquetes":['
    _pri=1
    while IFS="$(printf '\t')" read -r _c _n _e _d; do
        [ "$_c" = "PAQUETE" ] || continue
        [ "$_pri" = 1 ] || printf ','
        _pri=0
        printf '{"nombre":"%s","motivo":"%s"}' "$(escapar "$_n")" "$(escapar "$_d")"
    done < "$FILAS"
    printf ']}\n'
}

escapar() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# Lo mismo, en líneas con "|" por separador.
#
# Existe porque la pantalla de bienvenida está escrita en C y leía la salida
# BONITA: buscaba una línea que empezara por "Recomendado:" y los nombres de
# los apartados. Cualquier cambio de formato --- como el de ahora, que añade
# Bluetooth, cámara y discos --- la dejaba mostrando datos vacíos o viejos sin
# un solo error. Un formato pensado para leerlo una máquina no se rompe al
# mejorar el que leen las personas.
#
#   COMP|categoría|nombre|estado|detalle
#   PAQ|nombre|motivo
breve() {
    while IFS="$(printf '\t')" read -r _c _n _e _d; do
        if [ "$_c" = "PAQUETE" ]; then
            printf 'PAQ|%s|%s\n' "$_n" "$_d"
        else
            printf 'COMP|%s|%s|%s|%s\n' "$_c" "$_n" "$_e" "$_d"
        fi
    done < "$FILAS"
}

# ======================================================================= main
escanear

case "${1:-}" in
    --json)
        json
        ;;
    --breve)
        breve
        ;;
    --lista)
        # shellcheck disable=SC2086
        [ -n "$INSTALAR" ] && printf '%s\n' $INSTALAR
        ;;
    --instalar)
        [ -n "$INSTALAR" ] || { t 'No hay nada que instalar.'; echo; exit 0; }
        # -y a propósito: quien llega aquí ya ha dicho que sí, sea pulsando el
        # botón del panel o escribiendo --instalar. Volver a preguntar dejaba
        # la instalación parada esperando una tecla que nadie iba a pulsar.
        # shellcheck disable=SC2086
        exec mpm install -y $INSTALAR
        ;;
    *)
        texto
        # El problema del huevo y la gallina, dicho antes de que muerda: todo
        # esto se descarga, y si lo que falta es justo el firmware de la Wi-Fi,
        # por Wi-Fi no se puede resolver.
        if [ -n "$INSTALAR" ] && ! m-internet >/dev/null 2>&1; then
            t 'AVISO: ahora mismo no hay internet, y esto se descarga.'; echo
            echo
            case "$INSTALAR" in
                *firmware*|*wifi*)
                    t '  Y lo que falta es justo lo que da acceso a la red. Tres salidas:'; echo
                    t '    1. Un cable de red, o un adaptador USB.'; echo
                    t '    2. El móvil por USB con «compartir internet» activado.'; echo
                    t '    3. Descargar el paquete en otro equipo y traerlo en un USB:'; echo
                    echo "       mpm install /ruta/al/paquete.mpk"
                    ;;
                *)
                    t '  Conéctate a una red y vuelve a ejecutar esto.'; echo
                    ;;
            esac
            echo
        fi
        [ -n "$INSTALAR" ] && {
            t 'Para instalarlo todo:  m-drivers --instalar'; echo
            t 'Para elegir uno:       mpm install <nombre>'; echo
        }
        ;;
esac
exit 0
