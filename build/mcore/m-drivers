#!/bin/sh
# m-drivers - mira TODO lo que hay en este equipo y dice qué le falta a cada
# cosa para funcionar del todo.
#
# No adivina por el nombre comercial: lee los identificadores que el propio
# hardware publica en /sys/bus/pci y /sys/bus/usb, que es lo único fiable. De
# cada componente dice en qué estado está -- y son estados distintos, con
# soluciones distintas, que desde fuera se ven todos igual:
#
#   ok            funciona
#   sin-driver    el kernel no tiene quien lo maneje
#   sin-firmware  hay driver, pero le falta un archivo de firmware
#   apagado       está todo, pero el servicio que lo usa no está en pie
#   mejorable     funciona, y hay un paquete que lo hace ir mejor
#
# Antes sólo miraba gráfica, red, sonido, entrada y procesador, y sólo sabía
# proponer paquetes: no sabía decir si algo ya detectado estaba muerto. El
# Bluetooth, que es justo lo que más se queda a medias, no aparecía por ningún
# lado.
#
#   m-drivers              el informe
#   m-drivers --json       lo mismo para el Centro de Control
#   m-drivers --breve      lo mismo en líneas, para la pantalla de bienvenida
#   m-drivers --lista      sólo los paquetes recomendados
#   m-drivers --instalar   los instala
set -u

PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
export PATH

PCI="/sys/bus/pci/devices"
USB="/sys/bus/usb/devices"
INSTALAR=""
FILAS="${TMPDIR:-/tmp}/.m-drivers.$$"
: > "$FILAS"
trap 'rm -f "$FILAS"' EXIT INT TERM

# La base de identificadores de fabricante que trae el sistema da el nombre
# comercial; sin ella se enseña el identificador en crudo, que sigue sirviendo.
IDS=""
for _f in /usr/share/hwdata/pci.ids /usr/share/misc/pci.ids /usr/share/pci.ids; do
    [ -f "$_f" ] && { IDS="$_f"; break; }
done

nombre_dispositivo() {
    # $1 = vendedor (4 hex), $2 = dispositivo (4 hex)
    [ -n "$IDS" ] || { printf '%s:%s' "$1" "$2"; return; }
    _n="$(awk -v v="$1" -v d="$2" '
        /^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]  / {
            envendedor = (substr($0, 1, 4) == v)
            if (envendedor) vnom = substr($0, 7)
            next
        }
        envendedor && /^\t[0-9a-f][0-9a-f][0-9a-f][0-9a-f]  / {
            if (substr($0, 2, 4) == d) { print vnom " " substr($0, 8); exit }
        }
    ' "$IDS" 2>/dev/null)"
    [ -n "$_n" ] && printf '%s' "$_n" || printf '%s:%s' "$1" "$2"
}

leer_hex() { [ -f "$1" ] && sed 's/^0x//' "$1" || echo ""; }
is_instalado() { [ -f "/var/lib/mpm/installed/$1.json" ]; }

# ¿Este dispositivo pidió un firmware que no estaba? Lo dice el kernel.
firmware_que_falta() {
    dmesg 2>/dev/null | awk -v d="$1" '
        index($0, d) && /Direct firmware load/ {
            if (match($0, /for [^ ]+/)) { print substr($0, RSTART + 4, RLENGTH - 4); exit }
        }'
}

# ¿Hay un proceso con este nombre?
#
# NO se usa "pgrep -x", y esto costó un rato: el pgrep de BusyBox compara el
# patrón con la línea de órdenes ENTERA, así que "pgrep -x pipewire" no
# encuentra un proceso lanzado como "/usr/bin/pipewire" --- pero sí encuentra
# "Hyprland", que se lanza sin ruta. O sea que funcionaba en unos sitios y en
# otros no, en silencio: el informe decía "pipewire no está en marcha" con el
# sonido sonando.
proceso_vivo() {
    pgrep "$1" >/dev/null 2>&1
}

# ¿Está en pie el servicio? runit deja un directorio "supervise" con el estado.
servicio_vivo() {
    # Sin /var/service no estamos en un MIKE OS arrancado (pasa al ejecutar
    # esto desde el equipo de construcción): entonces la única prueba honesta
    # es si el proceso está o no.
    if [ ! -d "/var/service/$1" ]; then
        proceso_vivo "$1"
        return
    fi
    if command -v sv >/dev/null 2>&1; then
        sv status "$1" 2>/dev/null | grep -q '^run:' && return 0
        return 1
    fi
    proceso_vivo "$1"
}

