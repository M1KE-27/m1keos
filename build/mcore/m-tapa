#!/bin/sh
# m-tapa - qué pasa al cerrar y abrir la tapa del portátil.
#
# No existía nada de esto. En una máquina virtual no hay tapa; en un portátil,
# cerrarla y que la pantalla siga encendida es quedarse sin batería dentro de la
# mochila. Y un apagado de golpe con la raíz en btrfs puede dejar el sistema de
# archivos a medias.
#
# Lo que hace al cerrar:
#   1. Bloquea la sesión, para que abrirla pida la contraseña.
#   2. Apaga la pantalla, que es lo que de verdad ahorra batería.
#
# Y suspender, SI SE PIDE. Ya no se decide aquí: lo elige quien usa el equipo
# desde el Centro de Control, y se guarda en ~/.config/mike/tapa.
#
#   pantalla    bloquear y apagar la pantalla   (lo de siempre, y el valor
#               por defecto: funciona en todos los equipos)
#   suspender   dormir de verdad
#   hibernar    volcar la memoria al disco y apagarse
#   nada        no hacer nada
#
# Por qué no es "suspender" por defecto: suspender y despertar depende del
# firmware del equipo, y uno que suspende pero no despierta es peor que uno
# que no suspende -- pierdes el trabajo y encima parece que se ha roto. Así
# que se ofrece, se avisa, y lo elige quien puede probarlo en su portátil.
# Además, m-energia sólo ofrece en el menú lo que /sys/power/state dice que
# este equipo soporta de verdad.
#
#   m-tapa cerrar     bloquea y apaga la pantalla
#   m-tapa abrir      enciende la pantalla
set -u

PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
export PATH

# Con un monitor externo conectado, cerrar la tapa NO debe apagar nada: mucha
# gente usa el portátil cerrado con una pantalla y un teclado fuera, y apagarle
# la pantalla externa sería exactamente lo contrario de lo que quiere.
pantallas_externas() {
    _n=0
    for _s in /sys/class/drm/card*-*/status; do
        [ -r "$_s" ] || continue
        [ "$(cat "$_s" 2>/dev/null)" = "connected" ] || continue
        case "$_s" in
            # eDP y LVDS son la pantalla interna del propio portátil.
            *eDP*|*LVDS*) continue ;;
        esac
        _n=$((_n + 1))
    done
    echo "$_n"
}

case "${1:-}" in
    cerrar)
        if [ "$(pantallas_externas)" -gt 0 ]; then
            # Hay monitor externo: se deja todo como está.
            exit 0
        fi
        _que="$(m-energia tapa 2>/dev/null || echo pantalla)"
        [ "$_que" = "nada" ] && exit 0

        # Bloquear SIEMPRE antes de nada más, sea cual sea la opción: si la
        # tapa se cierra y el equipo se duerme sin bloquear, cualquiera que la
        # abra entra directo.
        command -v m-bloquear >/dev/null 2>&1 && setsid m-bloquear >/dev/null 2>&1 &
        sleep 1

        case "$_que" in
            suspender|hibernar)
                # Apagar la pantalla antes de dormir: si el despertar tarda,
                # al menos no se queda encendida dentro de la mochila.
                hyprctl dispatch dpms off >/dev/null 2>&1 || true
                if ! m-energia "$_que" >/dev/null 2>&1; then
                    # No se pudo dormir. No se deja el equipo encendido y a
                    # oscuras sin explicación: se vuelve al comportamiento que
                    # siempre funciona.
                    echo "m-tapa: este equipo no pudo $_que; pantalla apagada." >&2
                fi
                ;;
            *)
                hyprctl dispatch dpms off >/dev/null 2>&1 || true
                ;;
        esac
        ;;

    abrir)
        hyprctl dispatch dpms on >/dev/null 2>&1 || true
        ;;

    *)
        echo "Uso: m-tapa [cerrar|abrir]" >&2
        exit 1
        ;;
esac
