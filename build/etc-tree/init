#!/bin/sh
# MIKE OS - PID 1 Universal Entrypoint
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

log() { echo "[init] $*"; }

mount_once() {
    # mountpoint no siempre existe en initramfs mínimos; el segundo chequeo
    # mantiene compatibilidad con BusyBox y evita montajes duplicados.
    _target="$1"
    shift
    mountpoint -q "$_target" 2>/dev/null && return 0
    mount "$@" "$_target" 2>/dev/null || return 1
}

wait_for_block() {
    _dev="$1"
    _timeout="${2:-15}"
    _i=0
    while [ ! -b "$_dev" ] && [ "$_i" -lt "$_timeout" ]; do
        # Algunos discos virtio/SCSI aparecen después de que se ejecute /init.
        modprobe virtio_pci 2>/dev/null || true
        modprobe virtio_blk 2>/dev/null || true
        modprobe ahci 2>/dev/null || true
        modprobe sd_mod 2>/dev/null || true
        sleep 1
        _i=$((_i + 1))
    done
    [ -b "$_dev" ]
}

# ¿Hemos arrancado desde un medio extraíble (el USB en vivo)?
#
# Se mira si existe algún bloque EXTRAÍBLE que lleve la etiqueta del medio de
# instalación. Es lo que distingue "estoy en el USB" de "estoy en un equipo
# instalado", y sin esa distinción el USB en vivo se pondría a arrancar el
# sistema del disco duro.
en_medio_extraible() {
    for _b in /sys/block/*; do
        [ -f "$_b/removable" ] || continue
        [ "$(cat "$_b/removable" 2>/dev/null)" = "1" ] || continue
        _nombre="$(basename "$_b")"
        for _p in "/dev/$_nombre" "/dev/$_nombre"[0-9]*; do
            [ -b "$_p" ] || continue
            case "$(blkid -o value -s LABEL "$_p" 2>/dev/null)" in
                MIKEOS|MIKEOS_EFI) return 0 ;;
            esac
        done
    done
    return 1
}

resolve_root() {
    _spec="$1"
    case "$_spec" in
        LABEL=*|UUID=*)
            findfs "$_spec" 2>/dev/null || true
            ;;
        /dev/*) echo "$_spec" ;;
        # "vivo" no es un dispositivo: lo resuelve montar_en_vivo buscando el
        # medio que lleva el sistema.
        *) echo "" ;;
    esac
}

# Montar sistemas esenciales
[ -d /proc ] || mkdir -p /proc
[ -d /sys ] || mkdir -p /sys
[ -d /dev ] || mkdir -p /dev
[ -d /run ] || mkdir -p /run
[ -d /tmp ] || mkdir -p /tmp

mount_once /proc -t proc none || log "No se pudo montar /proc"
mount_once /sys -t sysfs none || log "No se pudo montar /sys"
mountpoint -q /dev 2>/dev/null || mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs none /dev
mount_once /run -t tmpfs none || true
mount_once /tmp -t tmpfs none || true
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts -o mode=0620,gid=5 2>/dev/null || true
mountpoint -q /dev/shm 2>/dev/null || mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm 2>/dev/null || true

# Nodos estáticos mínimos garantizados
mknod -m 600 /dev/console c 5 1 2>/dev/null || true
mknod -m 666 /dev/tty c 5 0 2>/dev/null || true
mknod -m 666 /dev/tty0 c 4 0 2>/dev/null || true
mknod -m 666 /dev/tty1 c 4 1 2>/dev/null || true
mknod -m 666 /dev/tty2 c 4 2 2>/dev/null || true
mknod -m 666 /dev/null c 1 3 2>/dev/null || true
mknod -m 666 /dev/zero c 1 5 2>/dev/null || true
mknod -m 666 /dev/ptmx c 5 2 2>/dev/null || true

# Los drivers de almacenamiento/red están integrados en el kernel portable.
# Solo intentar módulos si una instalación avanzada los proporcionó; llamar a
# modprobe sin /lib/modules en un live mínimo puede introducir demoras largas.
if [ -d /lib/modules ]; then
    for _module in virtio_pci virtio_blk virtio_net ahci ata_piix nvme vmw_pvscsi vmxnet3 8139too e1000 e1000e hv_vmbus hv_storvsc hv_netvsc; do
        modprobe "$_module" 2>/dev/null || true
    done
fi

# Comprobar modo Recovery
if grep -q "mikeos_recovery=1" /proc/cmdline 2>/dev/null; then
    echo ""
    echo "=========================================================="
    echo "               MIKE OS — MODO RECOVERY"
    echo "=========================================================="
    echo "Entrando a shell de rescate como root..."
    exec /bin/bash -l </dev/console >/dev/console 2>&1
fi

# Si se especificó arranque en disco persistente (root=/dev/vda o root=/dev/sda)
# Se recorre entera y gana el ÚLTIMO valor de cada clave. Importa: el kernel
# lleva su propia línea compilada dentro (CONFIG_CMDLINE) y el gestor de
# arranque añade la suya detrás, así que en un sistema instalado llegan dos
# "root=" -- el de fábrica (/dev/ram0) y el bueno. Quedarse con el primero es
# arrancar siempre el equivocado.
ROOT_SPEC=""
ROOT_FS=""
ROOT_FLAGS=""
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        root=*)        ROOT_SPEC="${arg#root=}" ;;
        rootfstype=*)  ROOT_FS="${arg#rootfstype=}" ;;
        rootflags=*)   ROOT_FLAGS="${arg#rootflags=}" ;;
    esac
done

# --- Arranque en vivo ---------------------------------------------------
#
# El sistema completo viaja comprimido en el medio (mikeos/sistema.squashfs).
# Se monta de sólo lectura y se le pone encima un tmpfs con overlayfs, así que:
#
#   · se puede escribir en todas partes, pero los cambios van a memoria y el
#     USB no se toca (ni se desgasta, ni importa que esté protegido);
#   · NO se cargan 627 MB en RAM: squashfs lee del medio sólo lo que se usa;
#   · y hay escritorio de verdad, no una consola pelada.
#
# Antes de esto, el "modo en vivo" era quedarse dentro del initramfs, que
# excluye /usr/lib, Hyprland y quickshell. O sea que el USB prometía "prueba el
# sistema entero" y arrancaba en una terminal sin escritorio posible.
montar_en_vivo() {
    _medio=""
    mkdir -p /mnt/medio /mnt/sistema /mnt/cambios /mnt/root

    # Buscar el medio que lleva el sistema. Se recorren los bloques en vez de
    # confiar en un nombre fijo: el USB puede ser sda, sdb o nvme según el
    # equipo, y en una Surface no es el mismo que en un portátil cualquiera.
    # Treinta segundos, no diez. En un portátil real la controladora USB puede
    # tardar bastante más que en una máquina virtual en enumerar el pendrive, y
    # rendirse a los diez segundos es rendirse antes de tiempo. Se avisa por
    # pantalla mientras tanto: una espera con explicación no es lo mismo que una
    # pantalla negra.
    _intentos=30
    _i=0
    while [ "$_i" -lt "$_intentos" ]; do
        for _d in /dev/sr* /dev/sd* /dev/nvme*n* /dev/vd* /dev/mmcblk* /dev/dm-*; do
            [ -b "$_d" ] || continue
            mount -o ro "$_d" /mnt/medio 2>/dev/null || continue
            if [ -f /mnt/medio/mikeos/sistema.squashfs ]; then
                _medio="$_d"
                break
            fi
            umount /mnt/medio 2>/dev/null || true
        done
        [ -n "$_medio" ] && break
        _i=$((_i + 1))
        [ "$_i" = "5" ] && log "Buscando el medio de instalación..."
        [ "$_i" = "15" ] && log "Sigo buscando el USB. Si tarda mucho más, algo va mal."
        sleep 1
    done

    if [ -z "$_medio" ]; then
        # Esto tiene que verse. La versión anterior seguía adelante en silencio
        # y acababa arrancando dentro del initramfs: sin escritorio y sin
        # explicación, o sea una pantalla negra durante horas. Pasó en una
        # Surface Laptop 4 con la imagen puesta con Ventoy.
        echo
        echo "=========================================================="
        echo "  NO ENCUENTRO EL SISTEMA EN NINGÚN DISPOSITIVO"
        echo "=========================================================="
        echo
        echo "  He mirado en todos los discos conectados y en ninguno está"
        echo "  mikeos/sistema.squashfs, que es donde vive el sistema."
        echo
        echo "  Lo que he visto:"
        for _d in /dev/sr* /dev/sd* /dev/nvme*n* /dev/vd* /dev/mmcblk*; do
            [ -b "$_d" ] && echo "    $_d"
        done
        echo
        echo "  La causa más habitual es haber copiado la ISO con Ventoy o"
        echo "  con un programa que la descomprime. Esta imagen hay que"
        echo "  escribirla TAL CUAL en el USB:"
        echo
        echo "    sudo dd if=mikeos.iso of=/dev/sdX bs=4M status=progress oflag=sync"
        echo
        echo "  Se abre una consola de rescate. Escribe  lsblk  para ver los"
        echo "  discos, o  poweroff  para apagar."
        echo "=========================================================="
        echo
        return 1
    fi
    log "Sistema encontrado en $_medio"

    mount -t squashfs -o ro,loop /mnt/medio/mikeos/sistema.squashfs /mnt/sistema 2>/dev/null \
        || { log "No se pudo montar el sistema comprimido"; return 1; }

    # Los cambios en memoria. El 50 % es un tope, no una reserva: tmpfs sólo
    # ocupa lo que se escriba de verdad.
    mount -t tmpfs -o size=50%,mode=0755 tmpfs /mnt/cambios 2>/dev/null || return 1
    mkdir -p /mnt/cambios/arriba /mnt/cambios/trabajo

    mount -t overlay overlay \
        -o lowerdir=/mnt/sistema,upperdir=/mnt/cambios/arriba,workdir=/mnt/cambios/trabajo \
        /mnt/root 2>/dev/null \
        || { log "No se pudo montar la capa de escritura"; return 1; }

    # El medio se queda montado dentro del sistema: el instalador lo necesita
    # para copiar, y así "m-install" funciona desde el propio USB.
    # El medio se deja en /mnt/medio y NO en /run/medio. En /run duraba lo que
    # tardaba el sistema en montar su propio tmpfs encima, que lo tapaba: la
    # entrada seguía en /proc/mounts, pero la carpeta ya no existía para nadie.
    # Eso dejaba al instalador sin poder leer el kernel del USB y la
    # instalación terminaba sin arranque.
    mkdir -p /mnt/root/mnt/medio
    mount --move /mnt/medio /mnt/root/mnt/medio 2>/dev/null || true
    return 0
}

ROOT_DEV="$(resolve_root "$ROOT_SPEC")"

# Último recurso: buscar la raíz por su etiqueta.
#
# Hace falta por un caso concreto y grave. El kernel lleva su línea de órdenes
# compilada dentro (CONFIG_CMDLINE) porque, cuando la firmware UEFI arranca el
# kernel directamente, no le pasa NINGÚN argumento. Esa línea dice
# root=/dev/ram0, que es lo correcto para el USB.
#
# Pero un sistema ya instalado también tiene una copia del kernel en
# EFI/BOOT/BOOTX64.EFI, que es la ruta que prueba cualquier firmware sin
# necesidad de registrar nada. Si se arranca por ahí --porque la entrada de la
# UEFI no se creó, o se perdió al actualizar la firmware, o alguien reinició la
# NVRAM-- el kernel usa su línea compilada, busca la raíz en /dev/ram0, no la
# encuentra y el equipo no enciende. Sin pistas.
#
# Así que si no hay raíz utilizable, se busca una partición con la etiqueta que
# pone el instalador. Se excluyen los discos extraíbles: si no, el USB en vivo
# arrancaría el sistema instalado del equipo en vez de sí mismo, que es
# justo lo contrario de para lo que sirve un USB en vivo.
if [ -z "$ROOT_DEV" ] || [ "$ROOT_DEV" = "/dev/ram0" ]; then
    if ! en_medio_extraible; then
        _por_etiqueta="$(findfs LABEL=MIKEOS_ROOT 2>/dev/null || true)"
        if [ -n "$_por_etiqueta" ]; then
            log "Sin raíz en la línea de órdenes; encontrada por etiqueta: $_por_etiqueta"
            ROOT_DEV="$_por_etiqueta"
        fi
    fi
fi
# Treinta segundos, no quince. Un NVMe de portátil puede tardar bastante más
# que un disco virtual en estar listo, y rendirse pronto significa arrancar sin
# raíz: o sea, a una consola pelada sin explicación. Esperar de más no le
# cuesta nada a quien tiene un disco rápido, porque en cuanto aparece sigue.
ROOT_TIMEOUT=30
[ -f /etc/mikeos/boot.conf ] && . /etc/mikeos/boot.conf

# root=vivo lo pone el menú de GRUB del USB. También se intenta cuando no hay
# raíz utilizable: así el medio arranca aunque nadie le haya pasado nada.
if [ "$ROOT_SPEC" = "vivo" ] || { [ -z "$ROOT_DEV" ] || [ "$ROOT_DEV" = "/dev/ram0" ]; }; then
    if montar_en_vivo; then
        log "Arrancando en vivo desde el medio"
        for _m in dev proc sys run tmp; do
            mkdir -p "/mnt/root/$_m"
        done
        mount --move /dev /mnt/root/dev 2>/dev/null || mount -t devtmpfs devtmpfs /mnt/root/dev
        mount --move /proc /mnt/root/proc 2>/dev/null || mount -t proc proc /mnt/root/proc
        mount --move /sys /mnt/root/sys 2>/dev/null || mount -t sysfs sysfs /mnt/root/sys
        mkdir -p /mnt/root/dev/pts /mnt/root/dev/shm
        mount -t devpts devpts /mnt/root/dev/pts -o mode=0620,gid=5 2>/dev/null || true
        mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /mnt/root/dev/shm 2>/dev/null || true
        exec switch_root /mnt/root /sbin/runit
    fi
    log "No se pudo arrancar en vivo; se sigue con lo que haya"
fi

if [ -n "$ROOT_DEV" ] && [ "$ROOT_DEV" != "/dev/ram0" ] && wait_for_block "$ROOT_DEV" "${ROOT_TIMEOUT:-15}"; then
    log "Montando disco raíz persistente: $ROOT_DEV"
    mkdir -p /mnt/root
    # rootflags NO es opcional con btrfs. m-install crea la raíz dentro del
    # subvolumen @, así que sin "subvol=@" se monta el nivel de arriba: ahí
    # sólo están @, @home y @instantaneas, no hay /sbin/runit, y el arranque
    # se rendía y seguía corriendo dentro del initramfs. El sistema parecía
    # encender -- llegaba a runit y a la consola -- pero era el initramfs, no
    # el disco: sin escritorio, sin fastfetch y sin nada instalado.
    OPCIONES_RAIZ="rw,noatime"
    [ -n "$ROOT_FLAGS" ] && OPCIONES_RAIZ="$OPCIONES_RAIZ,$ROOT_FLAGS"
    if mount -t "${ROOT_FS:-auto}" -o "$OPCIONES_RAIZ" "$ROOT_DEV" /mnt/root 2>/dev/null \
       || mount -o "$OPCIONES_RAIZ" "$ROOT_DEV" /mnt/root 2>/dev/null \
       || mount "$ROOT_DEV" /mnt/root 2>/dev/null; then
      if [ -x /mnt/root/sbin/runit ]; then
        # Preparar nodos y devtmpfs en la raíz persistente antes de switch_root
        mkdir -p /mnt/root/dev /mnt/root/proc /mnt/root/sys /mnt/root/run /mnt/root/tmp
        mknod -m 600 /mnt/root/dev/console c 5 1 2>/dev/null || true
        mknod -m 666 /mnt/root/dev/tty c 5 0 2>/dev/null || true
        mknod -m 666 /mnt/root/dev/tty0 c 4 0 2>/dev/null || true
        mknod -m 666 /mnt/root/dev/tty1 c 4 1 2>/dev/null || true
        mknod -m 666 /mnt/root/dev/tty2 c 4 2 2>/dev/null || true
        mknod -m 666 /mnt/root/dev/null c 1 3 2>/dev/null || true
        mknod -m 666 /mnt/root/dev/zero c 1 5 2>/dev/null || true
        mknod -m 666 /mnt/root/dev/ptmx c 5 2 2>/dev/null || true

        mount --move /dev /mnt/root/dev 2>/dev/null || mount -t devtmpfs devtmpfs /mnt/root/dev
        mount --move /proc /mnt/root/proc 2>/dev/null || mount -t proc proc /mnt/root/proc
        mount --move /sys /mnt/root/sys 2>/dev/null || mount -t sysfs sysfs /mnt/root/sys
        mount --move /run /mnt/root/run 2>/dev/null || mount -t tmpfs none /mnt/root/run
        mount --move /tmp /mnt/root/tmp 2>/dev/null || mount -t tmpfs none /mnt/root/tmp
        # devtmpfs no provee /dev/shm por sí solo; sin este tmpfs, cualquier
        # cliente Wayland que use shm_open() (memoria compartida POSIX para
        # buffers) falla con "fd != -1" en pool-buffer.c.
        mkdir -p /mnt/root/dev/shm
        mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /mnt/root/dev/shm

        log "Cambiando a raíz de disco persistente con switch_root"
        exec switch_root /mnt/root /sbin/runit
      else
        log "La partición no contiene un MIKE OS válido; se mantiene initramfs"
        umount /mnt/root 2>/dev/null || true
      fi
    else
        log "No se pudo montar $ROOT_DEV; se mantiene initramfs"
    fi
fi

# Nada ha funcionado: ni medio en vivo ni disco con sistema.
#
# Antes aquí se ejecutaba runit dentro del initramfs sin decir nada. El
# initramfs no tiene /usr ni escritorio, así que el resultado era una pantalla
# casi en negro, sin errores y sin forma de saber qué había pasado. Alguien
# estuvo esperando horas delante de eso.
#
# Ahora se explica y se deja una consola con la que se puede investigar.
echo
echo "MIKE OS no ha podido arrancar ningún sistema."
echo "Esto es la consola del arranque, no el sistema: aquí hay muy poco."
echo
echo "  lsblk           qué discos ve el equipo"
echo "  cat /proc/cmdline   con qué parámetros arrancó"
echo "  poweroff        apagar"
echo
exec /bin/sh -l
