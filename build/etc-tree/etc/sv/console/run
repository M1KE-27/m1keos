#!/bin/sh
exec 2>&1
cd /root

# TERM: sin esto la consola es inusable, y de una forma que parece un sistema
# roto y no un ajuste que falta.
#
# runit arranca los servicios con un entorno vacío, así que bash nacía SIN
# TERM. readline entonces da por hecho que la terminal no sabe mover el cursor,
# y a partir de ahí: el borrado no borra, Enter devuelve el cursor por encima
# de lo escrito, y el propio prompt se sobrescribe. Escribir dos órdenes
# seguidas se vuelve imposible. La base de datos de terminales (terminfo) SÍ
# estaba instalada; lo que faltaba era decirle a bash cuál usar.
#
# "linux" es la terminal del kernel, que es exactamente lo que hay delante
# cuando esto corre. Si alguien ya trae TERM (por SSH, por ejemplo), se
# respeta el suyo.
[ -n "${TERM:-}" ] || TERM=linux
export TERM

# El idioma. runit arranca los servicios con el entorno vacío, así que sin esto
# la sesión gráfica entera corre en locale "C", que no es UTF-8: acentos y
# comillas rotos en la barra, en el instalador y en el navegador. glibc 2.44
# trae C.UTF-8 integrado, no hace falta instalar nada.
[ -n "${LANG:-}" ] || LANG=C.UTF-8
export LANG

IS_GUI="no"
if grep -qw 'mikeos_gui=1' /proc/cmdline 2>/dev/null || [ -f /etc/mikeos/desktop_enabled ]; then
    IS_GUI="yes"
fi

# Logging de diagnóstico del servicio de consola
echo "[console] cmdline: $(cat /proc/cmdline 2>/dev/null || echo '')"
echo "[console] GUI mode: $IS_GUI"
echo "[console] tty1: $(ls -l /dev/tty1 2>/dev/null || echo 'missing')"
echo "[console] /dev/console: $(ls -l /dev/console 2>/dev/null || echo 'missing')"

# Diagnóstico de permisos. Está aquí y no en un script aparte porque, cuando el
# escritorio no arranca, este servicio es lo único que consigue escribir algo:
# ni hay sesión gráfica que mirar ni SSH por donde entrar.
echo "[console] usuario: $(id 2>/dev/null)"
echo "[console] raiz:    $(mount 2>/dev/null | grep ' / ' | head -1)"
echo "[console] /dev:    $(mount 2>/dev/null | grep ' /dev ' | head -1)"
if : > /dev/.prueba-escritura 2>/dev/null; then
    rm -f /dev/.prueba-escritura
    echo "[console] /dev es escribible"
else
    echo "[console] /dev NO es escribible"
fi

if [ "$IS_GUI" = "yes" ]; then
    echo ">> [console] Iniciando compositor gráfico directo en /dev/tty1..."
    chvt 1 2>/dev/null || true
    exec </dev/tty1 >/dev/tty1 2>&1
    chmod 666 /dev/input/event* /dev/tty1 2>/dev/null || true
    # Gráfica: igual que con /dev/snd, sin udev los nodos de /dev/dri nacen
    # root:root 600. Hyprland se salvaba porque seatd le pasa el descriptor
    # siendo root, pero cualquier otra aplicación que quisiera acelerar por
    # GPU -- un navegador, un juego -- no podía abrirlos y caía a renderizado
    # por software en la CPU. Ahí estaba buena parte de la lentitud.
    #
    # El chmod que había aquí no servía de nada: los nodos los crea el driver
    # de la tarjeta al cargarse, que ocurre después de este punto. Por eso se
    # reintenta en segundo plano durante unos segundos en vez de dar por
    # hecho que ya existen.
    (
        _i=0
        while [ "$_i" -lt 40 ]; do
            if [ -e /dev/dri/card0 ] || [ -e /dev/dri/renderD128 ]; then
                chgrp video /dev/dri/* 2>/dev/null || true
                chmod g+rw /dev/dri/* 2>/dev/null || true
                break
            fi
            sleep 0.25
            _i=$((_i + 1))
        done
    ) &
    # Sonido: sin udev, los nodos de /dev/snd nacen root:root 600 y ni
    # WirePlumber ni nadie del escritorio puede abrir la tarjeta. El grupo
    # audio ya existe y el usuario pertenece a él; sólo falta aplicarlo.
    # Sonido: los nodos de /dev/snd los crea el driver al cargarse, y el códec
    # de una Surface tarda en registrarse.
    #
    # Esto era una sola comprobación sin reintento: si /dev/snd todavía no
    # existía en este instante, el bloque entero se saltaba y los nodos se
    # quedaban root:root 0600 PARA SIEMPRE. WirePlumber no veía ninguna salida
    # y el volumen decía "no hay ninguna salida de audio conectada" en un
    # equipo con altavoces perfectamente montados.
    #
    # Veinte líneas más arriba, /dev/dri ya resuelve esta misma carrera con un
    # bucle de reintento y un comentario que la explica. El sonido se había
    # quedado con la versión de un solo intento.
    (
        _i=0
        while [ "$_i" -lt 60 ]; do
            if [ -d /dev/snd ] && [ -n "$(ls -A /dev/snd 2>/dev/null)" ]; then
                chgrp -R audio /dev/snd 2>/dev/null || true
                chmod -R g+rw /dev/snd 2>/dev/null || true
            fi
            sleep 0.5
            _i=$((_i + 1))
        done
    ) &
    # La sesión gráfica nunca corre como root: mike pertenece a wheel y
    # conserva acceso administrativo mediante m-sudo.
    if id mike >/dev/null 2>&1; then
        mkdir -p /run/user/1000
        chown mike:mike /run/user/1000 2>/dev/null || true
        chmod 700 /run/user/1000
        # Forzar un entorno de sesión completo evita que BusyBox su herede
        # HOME/SHELL de root en algunas imágenes o instalaciones antiguas.
        # El escritorio, y si se cae, VUELVE.
        #
        # Antes esto se ejecutaba una sola vez: cuando Hyprland terminaba -- por
        # un fallo, o porque alguien pulsó sin querer el atajo de salir -- el
        # servicio seguía adelante y entregaba una consola de root en tty1. Y
        # como el servicio "exec"aba una shell, runit lo veía vivo y tampoco lo
        # reiniciaba. Es decir: la sesión gráfica no volvía hasta reiniciar el
        # equipo entero.
        #
        # Se reintenta hasta tres veces seguidas. Si se cae tres veces en menos
        # de un minuto, el problema no se arregla insistiendo: ahí sí toca dar
        # una consola y decir por qué.
        _intentos=0
        while [ "$_intentos" -lt 3 ]; do
            _desde="$(date +%s 2>/dev/null || echo 0)"
            su mike -s /bin/sh -c 'export HOME=/home/mike USER=mike LOGNAME=mike SHELL=/bin/bash; exec /usr/bin/start-mike-desktop' \
                2>&1 | tee -a /var/log/desktop_session.log
            _hasta="$(date +%s 2>/dev/null || echo 0)"
            # Si duró un rato, el contador se reinicia: una sesión de dos horas
            # que se cierra no es lo mismo que una que no llega a arrancar.
            if [ $(( _hasta - _desde )) -gt 60 ]; then
                _intentos=0
            else
                _intentos=$((_intentos + 1))
            fi
            [ "$_intentos" -ge 3 ] && break
            echo ">> [console] La sesión gráfica terminó. Volviendo a arrancarla..."
            sleep 2
        done
        [ "$_intentos" -ge 3 ] && \
            echo ">> [console] Se ha caído tres veces seguidas. El registro está en /var/log/desktop_session.log"
    else
        /usr/bin/start-mike-desktop 2>&1 | tee /var/log/desktop_session.log
    fi
    echo ">> [console] Sesión gráfica finalizada."

    # Si se arrancó desde "Instalar MIKE OS en este equipo" y la sesión
    # gráfica no llegó a levantarse (equipo sin driver de vídeo), se instala
    # por texto. Aquí sí se puede: "setsid cttyhack" le da una terminal de
    # control de verdad, que es lo que le falta a la sesión gráfica, y este
    # servicio corre como root, que es lo que m-install necesita.
    #
    # Sin esto, elegir "Instalar" en un equipo sin gráfica terminaba en un
    # intérprete de órdenes pelado: la persona pidió instalar y el sistema se
    # encogía de hombros.
    if grep -qw "mikeos_instalar=1" /proc/cmdline 2>/dev/null; then
        echo ">> [console] Sin escritorio, así que instalo por texto."
        # Sin "exec": si se cancela la instalación, se cae al intérprete de
        # órdenes en vez de dejar el equipo sin nada delante.
        setsid cttyhack /usr/bin/m-install
    fi

    echo ">> [console] Iniciando shell de consola..."
    # La sesión gráfica puede haber dejado la terminal en un estado raro
    # (sin eco, en modo crudo). "stty sane" la devuelve a lo normal antes de
    # entregarla, para que el borrado y el Enter funcionen.
    stty sane 2>/dev/null || true
    exec setsid cttyhack /bin/bash -l
else
    echo ">> [console] Iniciando terminal interactiva en /dev/console..."
    exec </dev/console >/dev/console 2>&1
    stty sane 2>/dev/null || true
    exec setsid cttyhack /bin/bash -l
fi
